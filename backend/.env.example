# AURA Cinematic Studio Backend Environment Variables
PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aura_studio?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# JWT Authentication & Default Seed Secrets
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@aurastudio.com
ADMIN_PASSWORD=your_secure_admin_password
